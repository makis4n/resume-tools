{
  "version": 1,
  "id": "jake",
  "name": "Jake's Resume",
  "engine": "pdftex",
  "source": {
    "url": "https://github.com/jakegut/resume",
    "license": "MIT",
    "attribution": "Jake Gutierrez and Sourabh Bajaj (jakegut/resume, based on sb2nov/resume)"
  },
  "files": {
    "fontsize10.clo": "% The fontsize package reads this file as it loads, in place of setting every size from 10\n% points, its default, which it does even when it is given no size. So article's own sizes\n% stand, and the package adds only \\changefontsize, which the font size control calls.\n"
  },
  "controls": {
    "pageSize": {
      "default": "letter",
      "apply": {
        "letter": "\\geometry{letterpaper}",
        "a4": "\\geometry{a4paper}"
      }
    },
    "margins": {
      "default": 0.5,
      "apply": "\\geometry{margin={{value}}in}"
    },
    "fontSize": {
      "default": 11,
      "apply": "\\ifdim{{value}}pt=11pt\\else\\changefontsize{{{value}}pt}\\fi"
    },
    "font": {
      "default": "lm",
      "choices": [
        { "id": "lm", "name": "Latin Modern", "apply": "" },
        { "id": "charter", "name": "Charter", "apply": "\\renewcommand{\\rmdefault}{bch}" },
        { "id": "palatino", "name": "Palatino", "apply": "\\renewcommand{\\rmdefault}{ppl}" },
        {
          "id": "helvetica",
          "name": "Helvetica",
          "apply": "\\usepackage[scaled=.92]{helvet}\\renewcommand{\\familydefault}{\\sfdefault}"
        }
      ]
    },
    "accent": {
      "default": "#000000",
      "apply": "\\definecolor{rtaccent}{HTML}{{{value}}}"
    },
    "density": {
      "default": "normal",
      "apply": {
        "compact": "\\titlespacing*{\\section}{0pt}{10pt}{9pt}\\setlist[itemize,1]{topsep=2pt,itemsep=2pt}\\setlist[itemize,2]{topsep=2pt,itemsep=0pt}",
        "normal": "",
        "relaxed": "\\titlespacing*{\\section}{0pt}{22pt}{14pt}\\setlist[itemize,1]{topsep=12pt,itemsep=6pt}\\setlist[itemize,2]{topsep=6pt,itemsep=3pt}"
      }
    },
    "dateFormat": {
      "default": "MMM yyyy"
    }
  },
  "snippets": {
    "document": "\\begin{document}\n{{header}}\n{{sections}}\n\\end{document}",
    "header": "\\begin{center}\n    \\textbf{\\Huge \\scshape {{first}}{{#last}} {{last}}{{/last}}} \\\\ \\vspace{1pt}\n    \\small {{contacts}}\n\\end{center}",
    "contact": {
      "phone": "{{text}}",
      "email": "\\href{{{&href}}}{\\underline{{{text}}}}",
      "location": "{{text}}"
    },
    "link": {
      "other": "{{#href}}\\href{{{&href}}}{\\underline{{{#label}}{{label}}{{/label}}{{^label}}{{&href}}{{/label}}}}{{/href}}{{^href}}\\underline{{{label}}}{{/href}}"
    },
    "section": {
      "entries": "\\section{{{title}}}\n{{#entries}}\n\\resumeSubHeadingListStart\n{{entries}}\n\\resumeSubHeadingListEnd\n{{/entries}}",
      "list": "\\section{{{title}}}\n{{#items}}\n\\begin{itemize}[leftmargin=0.15in, label={}]\n\\small{\\item{\n{{items}}\n}}\n\\end{itemize}\n{{/items}}",
      "labelled": "\\section{{{title}}}\n{{#items}}\n\\begin{itemize}[leftmargin=0.15in, label={}]\n\\small{\\item{\n{{items}}\n}}\n\\end{itemize}\n{{/items}}",
      "paragraph": "\\section{{{title}}}\n{\\small {{text}}\\par}"
    },
    "entry": {
      "default": "\\resumeSubheading\n  {{{title}}}{{{dates}}}\n  {{{subtitle}}}{{{place}}}\n{{#bullets}}\n\\resumeItemListStart\n{{bullets}}\n\\resumeItemListEnd\n{{/bullets}}",
      "education": "\\resumeSubheading\n  {{{title}}}{{{place}}}\n  {{{subtitle}}}{{{dates}}}\n{{#bullets}}\n\\resumeItemListStart\n{{bullets}}\n\\resumeItemListEnd\n{{/bullets}}",
      "projects": "\\resumeProjectHeading\n  {\\textbf{{{title}}}{{#subtitle}}{{#title}} $|$ {{/title}}\\emph{{{subtitle}}}{{/subtitle}}}{{{dates}}}\n{{#bullets}}\n\\resumeItemListStart\n{{bullets}}\n\\resumeItemListEnd\n{{/bullets}}"
    },
    "bullet": "\\resumeItem{{{text}}}",
    "item": "\\leavevmode{{text}}",
    "labelledItem": "\\leavevmode{{#label}}\\textbf{{{label}}}: {{/label}}{{text}}",
    "separators": {
      "contacts": " $|$ ",
      "links": " $|$ ",
      "items": " \\\\\n"
    }
  }
}
