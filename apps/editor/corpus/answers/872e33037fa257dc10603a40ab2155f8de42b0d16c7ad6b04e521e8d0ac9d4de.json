        "latex": "\\makeatletter\n\\renewcommand*{\\mobile}[1]{%\n  \\def\\@mobile{#1}%\n  \\begingroup\n  \\let\\rtfield\\@secondoftwo\n  \\def\\@teluri{tel:#1}%\n  \\StrDel{\\@teluri}{ }[\\@teluri]%\n  \\StrDel{\\@teluri}{-}[\\@teluri]%\n  \\StrDel{\\@teluri}{(}[\\@teluri]%\n  \\StrDel{\\@teluri}{)}[\\@teluri]%\n  \\expandafter\\endgroup\\expandafter\\def\\expandafter\\@teluri\\expandafter{\\@teluri}%\n}\n\\makeatother"
